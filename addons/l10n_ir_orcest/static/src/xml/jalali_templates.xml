<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        قالب‌های جلالی برای نمایش تاریخ شمسی در رابط کاربری
        Jalali templates for displaying Solar Hijri dates in the UI
    -->

    <!-- Jalali Date Display Widget -->
    <t t-name="l10n_ir_orcest.JalaliDateField">
        <span class="o_jalali_date" t-att-title="props.gregorianDate">
            <t t-esc="props.jalaliDate"/>
        </span>
    </t>

    <!-- Jalali Month Selector -->
    <t t-name="l10n_ir_orcest.JalaliMonthSelector">
        <div class="o_jalali_month_selector d-flex align-items-center gap-2" dir="rtl">
            <button class="btn btn-sm btn-outline-secondary" t-on-click="onPrevMonth">
                <i class="fa fa-chevron-right"/>
            </button>
            <span class="o_jalali_month_title fw-bold">
                <t t-esc="state.monthName"/> <t t-esc="state.year"/>
            </span>
            <button class="btn btn-sm btn-outline-secondary" t-on-click="onNextMonth">
                <i class="fa fa-chevron-left"/>
            </button>
        </div>
    </t>

    <!-- Jalali Calendar Header -->
    <t t-name="l10n_ir_orcest.JalaliCalendarHeader">
        <div class="o_jalali_calendar_header" dir="rtl">
            <div class="d-flex justify-content-between align-items-center p-2">
                <button class="btn btn-link" t-on-click="onPrevPeriod">
                    <i class="fa fa-chevron-right fa-lg"/>
                </button>
                <h5 class="mb-0 text-center">
                    <t t-esc="props.title"/>
                </h5>
                <button class="btn btn-link" t-on-click="onNextPeriod">
                    <i class="fa fa-chevron-left fa-lg"/>
                </button>
            </div>
            <!-- Weekday headers (Saturday first) -->
            <div class="d-flex justify-content-around text-muted small py-1 border-bottom">
                <span>ش</span>
                <span>ی</span>
                <span>د</span>
                <span>س</span>
                <span>چ</span>
                <span>پ</span>
                <span class="text-danger">ج</span>
            </div>
        </div>
    </t>

    <!-- AI Assistant Panel -->
    <t t-name="l10n_ir_orcest.AIAssistantPanel">
        <div class="o_ai_assistant_panel card" dir="rtl">
            <div class="card-header bg-primary text-white d-flex align-items-center">
                <i class="fa fa-magic me-2"/>
                <span>دستیار هوشمند اورکست</span>
            </div>
            <div class="card-body">
                <div class="o_ai_messages" t-ref="messagesContainer">
                    <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                        <div t-attf-class="o_ai_message mb-2 p-2 rounded {{ msg.role === 'assistant' ? 'bg-light' : 'bg-primary-subtle' }}">
                            <small class="text-muted d-block mb-1">
                                <t t-if="msg.role === 'assistant'">دستیار هوشمند</t>
                                <t t-else="">شما</t>
                            </small>
                            <t t-esc="msg.content"/>
                        </div>
                    </t>
                </div>
                <div class="o_ai_input mt-2">
                    <div class="input-group">
                        <input type="text"
                               class="form-control"
                               placeholder="سوال خود را بپرسید..."
                               t-on-keydown="onKeydown"
                               t-ref="inputField"/>
                        <button class="btn btn-primary" t-on-click="onSend">
                            <i class="fa fa-paper-plane"/>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
