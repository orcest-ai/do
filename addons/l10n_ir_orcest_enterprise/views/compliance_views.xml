<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- فرم مسیر حسابرسی -->
    <record id="view_audit_log_form" model="ir.ui.view">
        <field name="name">orcest.audit.log.form</field>
        <field name="model">orcest.audit.log</field>
        <field name="arch" type="xml">
            <form string="مسیر حسابرسی" dir="rtl" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="action"/>
                            <field name="severity" widget="badge" decoration-info="severity == 'info'" decoration-warning="severity == 'warning'" decoration-danger="severity in ('error', 'critical')"/>
                            <field name="model_name"/>
                            <field name="record_id"/>
                            <field name="record_name"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="ip_address"/>
                            <field name="user_agent"/>
                            <field name="create_date"/>
                            <field name="checksum"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="old_values"/>
                        <field name="new_values"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_audit_log_list" model="ir.ui.view">
        <field name="name">orcest.audit.log.list</field>
        <field name="model">orcest.audit.log</field>
        <field name="arch" type="xml">
            <list string="مسیر حسابرسی" dir="rtl" create="false" edit="false">
                <field name="create_date"/>
                <field name="action"/>
                <field name="severity" widget="badge" decoration-info="severity == 'info'" decoration-warning="severity == 'warning'" decoration-danger="severity in ('error', 'critical')"/>
                <field name="model_name"/>
                <field name="record_name"/>
                <field name="user_id"/>
                <field name="ip_address"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_audit_log" model="ir.actions.act_window">
        <field name="name">مسیر حسابرسی</field>
        <field name="res_model">orcest.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- فرم مدیریت اسناد -->
    <record id="view_document_form" model="ir.ui.view">
        <field name="name">orcest.document.form</field>
        <field name="model">orcest.document</field>
        <field name="arch" type="xml">
            <form string="سند" dir="rtl">
                <header>
                    <button name="action_submit_review" string="ارسال برای بررسی" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_approve" string="تأیید" type="object" invisible="state != 'review'" class="btn-success"/>
                    <button name="action_archive" string="بایگانی" type="object" invisible="state not in ('approved', 'expired')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_type"/>
                            <field name="document_number"/>
                            <field name="department_id"/>
                            <field name="version"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="approver_id"/>
                            <field name="confidentiality" widget="badge"/>
                            <field name="expiry_date"/>
                            <field name="jalali_expiry"/>
                        </group>
                    </group>
                    <group>
                        <field name="tags"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_document_list" model="ir.ui.view">
        <field name="name">orcest.document.list</field>
        <field name="model">orcest.document</field>
        <field name="arch" type="xml">
            <list string="اسناد" dir="rtl">
                <field name="name"/>
                <field name="document_type"/>
                <field name="document_number"/>
                <field name="department_id"/>
                <field name="responsible_id"/>
                <field name="confidentiality" widget="badge"/>
                <field name="jalali_expiry"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'review'" decoration-success="state == 'approved'" decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <record id="action_document" model="ir.actions.act_window">
        <field name="name">اسناد دیجیتال</field>
        <field name="res_model">orcest.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- فرم چک‌لیست انطباق -->
    <record id="view_compliance_checklist_form" model="ir.ui.view">
        <field name="name">orcest.compliance.checklist.form</field>
        <field name="model">orcest.compliance.checklist</field>
        <field name="arch" type="xml">
            <form string="چک‌لیست انطباق" dir="rtl">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="framework"/>
                            <field name="status" widget="badge" decoration-success="status == 'compliant'" decoration-danger="status == 'non_compliant'" decoration-warning="status == 'in_progress'"/>
                            <field name="priority" widget="badge"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="due_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="evidence"/>
                        <field name="remediation_plan"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_compliance_checklist_list" model="ir.ui.view">
        <field name="name">orcest.compliance.checklist.list</field>
        <field name="model">orcest.compliance.checklist</field>
        <field name="arch" type="xml">
            <list string="چک‌لیست انطباق" dir="rtl">
                <field name="name"/>
                <field name="framework"/>
                <field name="status" widget="badge" decoration-success="status == 'compliant'" decoration-danger="status == 'non_compliant'" decoration-warning="status == 'in_progress'"/>
                <field name="priority" widget="badge"/>
                <field name="responsible_id"/>
                <field name="due_date"/>
            </list>
        </field>
    </record>

    <record id="action_compliance_checklist" model="ir.actions.act_window">
        <field name="name">چک‌لیست انطباق</field>
        <field name="res_model">orcest.compliance.checklist</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- امنیت - کلید API -->
    <record id="view_api_key_form" model="ir.ui.view">
        <field name="name">orcest.api.key.form</field>
        <field name="model">orcest.api.key</field>
        <field name="arch" type="xml">
            <form string="کلید API" dir="rtl">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_regenerate_key" string="بازتولید کلید" type="object" class="oe_stat_button" icon="fa-refresh" confirm="آیا از بازتولید کلید API اطمینان دارید؟"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="scopes"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="key_prefix"/>
                            <field name="key" invisible="1"/>
                            <field name="expires_at"/>
                            <field name="rate_limit"/>
                            <field name="total_requests"/>
                            <field name="last_used"/>
                        </group>
                    </group>
                    <group>
                        <field name="allowed_ips"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_api_key_list" model="ir.ui.view">
        <field name="name">orcest.api.key.list</field>
        <field name="model">orcest.api.key</field>
        <field name="arch" type="xml">
            <list string="کلیدهای API" dir="rtl">
                <field name="name"/>
                <field name="user_id"/>
                <field name="key_prefix"/>
                <field name="scopes"/>
                <field name="total_requests"/>
                <field name="last_used"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_api_key" model="ir.actions.act_window">
        <field name="name">کلیدهای API</field>
        <field name="res_model">orcest.api.key</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- لاگ API -->
    <record id="view_api_log_list" model="ir.ui.view">
        <field name="name">orcest.api.log.list</field>
        <field name="model">orcest.api.log</field>
        <field name="arch" type="xml">
            <list string="لاگ دسترسی API" dir="rtl" create="false" edit="false">
                <field name="create_date"/>
                <field name="api_key_id"/>
                <field name="method"/>
                <field name="endpoint"/>
                <field name="status_code"/>
                <field name="response_time_ms"/>
                <field name="ip_address"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>

    <record id="action_api_log" model="ir.actions.act_window">
        <field name="name">لاگ دسترسی API</field>
        <field name="res_model">orcest.api.log</field>
        <field name="view_mode">list</field>
    </record>

    <!-- سیاست امنیتی -->
    <record id="view_security_policy_form" model="ir.ui.view">
        <field name="name">orcest.security.policy.form</field>
        <field name="model">orcest.security.policy</field>
        <field name="arch" type="xml">
            <form string="سیاست امنیتی" dir="rtl">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="policy_type"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="سیاست رمز عبور" invisible="policy_type != 'password'">
                        <field name="min_password_length"/>
                        <field name="require_uppercase"/>
                        <field name="require_numbers"/>
                        <field name="require_special_chars"/>
                        <field name="password_expiry_days"/>
                        <field name="max_login_attempts"/>
                        <field name="lockout_duration_minutes"/>
                    </group>
                    <group string="سیاست نشست" invisible="policy_type != 'session'">
                        <field name="session_timeout_minutes"/>
                        <field name="concurrent_sessions"/>
                    </group>
                    <group string="سیاست داده" invisible="policy_type != 'data'">
                        <field name="data_retention_days"/>
                        <field name="encrypt_sensitive_data"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_security_policy_list" model="ir.ui.view">
        <field name="name">orcest.security.policy.list</field>
        <field name="model">orcest.security.policy</field>
        <field name="arch" type="xml">
            <list string="سیاست‌های امنیتی" dir="rtl">
                <field name="name"/>
                <field name="policy_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_security_policy" model="ir.actions.act_window">
        <field name="name">سیاست‌های امنیتی</field>
        <field name="res_model">orcest.security.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
